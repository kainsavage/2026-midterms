{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"allowJs": true,
		"useDefineForClassFields": true,
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
